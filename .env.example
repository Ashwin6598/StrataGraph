# ==========================================
# CodeGraph Environment Configuration
# ==========================================

# Database Connection (FalkorDB)
# Local Docker or Remote Cloud (e.g. app.falkordb.cloud)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=codegraph_demo

# Graph State Snapshot Persistence
FALKORDB_PERSIST_FILE=codegraph_local_store.json

# MCP Server Transport: "stdio" (local client execution) or "http" (cloud/container microservice)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_AUTH_TOKEN=
